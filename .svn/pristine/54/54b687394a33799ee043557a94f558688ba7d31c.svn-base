project.name=web-lab-3
project.version=1.0.0

src.dir=src/main/java
resources.dir=src/main/resources
web.dir=src/main/webapp
test.src.dir=src/test/java
xml.validation.root=.
xml.includes=pom.xml,module.xml,postgres-ds.xml,src/**/*.xml
xml.excludes=.idea/**,build/**,dist/**,target/**

build.dir=build
classes.dir=${build.dir}/classes
test.classes.dir=${build.dir}/test-classes
lib.dir=${build.dir}/lib
dist.dir=dist
doc.dir=${build.dir}/doc
reports.dir=${build.dir}/reports
tmp.dir=${build.dir}/tmp
alt.dir=${build.dir}/alt

jar.name=${project.name}-${project.version}.jar
alt.jar.name=${project.name}-${project.version}-alt.jar
war.name=ROOT.war
jar.path=${dist.dir}/${jar.name}
alt.jar.path=${dist.dir}/${alt.jar.name}
war.path=${dist.dir}/${war.name}
manifest.file=MANIFEST.MF
manifest.template=manifest.base.mf

java.source=17
java.target=17
encoding=UTF-8

main.class=app.AppMain
junit.report.file=${reports.dir}/junit/TESTS-TestSuites.xml

locales.dir=${resources.dir}/i18n
native2ascii.dir=${build.dir}/native2ascii

scp.host=gelios
scp.remote.dir=/home/studs/s466402/web_lab_3/wildfly37/standalone/deployments
scp.target.file=${war.path}

music.file=/System/Library/Sounds/Glass.aiff

# CSV list of class/file names that are safe for svn commit in 'diff' target.
allowed.diff.classes=build.xml,build.properties,manifest.base.mf

# Regex replacements for 'alt' target.
alt.replace.1.match=AreaChecker
alt.replace.1.value=AreaScanner
alt.replace.2.match=DataBaseManager
alt.replace.2.value=StorageService
